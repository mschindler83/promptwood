{
  "$comment": "Graphite / Cobalt v1 design tokens (the design). Single source of truth: gen_theme.py validates text contrast and emits Theme.hpp; ThemeManager builds QPalette + QSS + icon tints + overlay colours from it.",
  "surface": {
    "bgApp": "#121213", "bgDock": "#19191B", "bgRaised": "#202023", "bgOverlay": "#28282C", "bgTop": "#323237",
    "bgSunken": "#0E0E0F", "viewportBg": "#2B2B2D", "maskTray": "#151517"
  },
  "line": { "lineSubtle": "#232326", "lineControl": "#2E2E32", "lineStrong": "#414147" },
  "text": { "textPrimary": "#E6E6E9", "textSecondary": "#A3A3AB", "textTertiary": "#86868E", "textDisabled": "#58585E" },
  "semantic": { "positive": "#4FC48E", "warning": "#EFB246", "negative": "#F0645C", "negativeText": "#FF8A83", "mutedAlpha": 0.15 },
  "state": { "hoverAlpha": 0.045, "pressedAlpha": 0.08, "selInactiveAlpha": 0.075 },
  "axis": { "axisX": "#E5685F", "axisY": "#6CC48A", "axisZ": "#6A9BF0" },
  "component": {
    "sliderFill": "#29292E", "sliderFillEdge": "#3B3B42", "editBg": "#0A0A0B", "logoMark": "#6E6E76",
    "hudBg": "rgba(20,20,21,0.80)", "hudRing": "rgba(255,255,255,0.06)", "hudSep": "rgba(255,255,255,0.10)",
    "hudLabel": "rgba(20,20,21,0.86)", "overlayInk": "#FFFFFF", "overlayInkDim": "rgba(255,255,255,0.55)", "overlayHalo": "rgba(0,0,0,0.35)",
    "scrollHandle": "rgba(255,255,255,0.14)", "scrollHandleHover": "rgba(255,255,255,0.24)",
    "thumbRing": "rgba(255,255,255,0.07)", "swatchRing": "rgba(255,255,255,0.10)", "chipOnSelected": "rgba(255,255,255,0.13)",
    "textSelection": "rgba(91,141,239,0.42)", "accentMutedAlpha": 0.17, "accentLineAlpha": 0.55, "accentScrubAlpha": 0.28
  },
  "shadow": {
    "low": { "dy": 4, "blur": 12, "alpha": 0.35, "use": "tooltips" },
    "high": { "dy": 14, "blur": 36, "alpha": 0.55, "use": "menus, dialogs, floating docks, toasts" }
  },
  "accents": {
    "default": "Cobalt",
    "families": [
      { "name": "Iris",    "accent": "#8B7FFF", "hover": "#A59BFF", "pressed": "#786DDB", "onAccent": "#100E1F" },
      { "name": "Cobalt",  "accent": "#5B8DEF", "hover": "#7AA4F5", "pressed": "#4A7AD8", "onAccent": "#0B1426" },
      { "name": "Glacier", "accent": "#3FB8C4", "hover": "#66CAD3", "pressed": "#369EA9", "onAccent": "#04191C" },
      { "name": "Orchid",  "accent": "#C77DEB", "hover": "#D59AF0", "pressed": "#AB6CCA", "onAccent": "#1A0C22" },
      { "name": "Rose",    "accent": "#E9708F", "hover": "#F08EA7", "pressed": "#C9607B", "onAccent": "#240A12" },
      { "name": "Silver",  "accent": "#C8C8CE", "hover": "#DEDEE2", "pressed": "#ACACB1", "onAccent": "#141416" }
    ],
    "$pressed": "Only Cobalt's pressed value is in the design; the others are derived with Cobalt's ratio (x0.86 per channel)."
  },
  "space": { "s1": 2, "s2": 4, "s3": 6, "s4": 8, "s5": 12, "s6": 16, "s7": 24, "s8": 32 },
  "radius": { "r1": 2, "r2": 4, "r3": 6, "r4": 8 },
  "density": { "default": "Default", "rows": { "Compact": 22, "Default": 24, "Comfortable": 28 } },
  "metrics": {
    "layerRow": 44, "maskRow": 26, "tabHeight": 28, "gutter": 3, "menuBar": 30, "contextBar": 38, "statusBar": 24,
    "toolButton": 32, "toolStrip": 40, "sectionHeader": 26, "controlHeight": 22, "buttonHeight": 24, "buttonLarge": 28,
    "labelWidthMin": 112, "labelWidthCap": 148, "labelWidthCapDialog": 168, "trailingSlot": 24,
    "dialogHeader": 44, "dialogFooter": 52, "thumbnail": 32
  },
  "type": {
    "uiFamily": "Inter", "monoFamily": "JetBrains Mono",
    "display":    { "px": 24, "line": 32, "weight": 600 },
    "heading":    { "px": 15, "line": 20, "weight": 600 },
    "title":      { "px": 13, "line": 18, "weight": 600 },
    "body":       { "px": 12, "line": 16, "weight": 400 },
    "bodyStrong": { "px": 12, "line": 16, "weight": 500 },
    "small":      { "px": 11, "line": 14, "weight": 400 },
    "micro":      { "px": 10, "line": 12, "weight": 600 },
    "mono":       { "px": 11, "line": 16, "weight": 400 }
  },
  "contrast": {
    "$comment": "text tokens that must reach >= 4.5:1 on the listed surfaces (textDisabled is exempt, WCAG 1.4.3)",
    "minimum": 4.5,
    "pairs": [
      ["textPrimary", "bgApp"], ["textPrimary", "bgDock"], ["textPrimary", "bgRaised"], ["textPrimary", "bgOverlay"], ["textPrimary", "bgTop"],
      ["textSecondary", "bgApp"], ["textSecondary", "bgDock"], ["textSecondary", "bgRaised"], ["textSecondary", "bgOverlay"],
      ["textTertiary", "bgApp"], ["textTertiary", "bgDock"], ["textTertiary", "bgSunken"]
    ]
  }
}
