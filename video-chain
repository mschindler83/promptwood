#!/usr/bin/env bash
# Runs the video-chain command line (clips rendered by a running ComfyUI) with this project's Python.
set -u
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ ! -x "$HERE/.venv/bin/python" ]; then
    echo "video-chain: $HERE/.venv/bin/python is missing; run: uv sync" >&2
    exit 1
fi
exec "$HERE/.venv/bin/python" -m video_chain "$@"
